# ============================================
# Environment Control (ZORUNLU)
# ============================================
NEXT_PUBLIC_APP_ENV=test
APP_ENV=test
NEXT_PUBLIC_JIRA_ENVIRONMENT=test

# ============================================
# Supabase (Test/Local) - ZORUNLU
# ============================================
NEXT_PUBLIC_SUPABASE_URL_TEST=<YOUR_SUPABASE_PROJECT_URL>
NEXT_PUBLIC_SUPABASE_ANON_KEY_TEST=<YOUR_SUPABASE_ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY_TEST=<YOUR_SUPABASE_SERVICE_ROLE_KEY>

# ============================================
# Supabase (Production - Fallback) - OPSİYONEL
# Production değerleri yorum satırında tutuluyor, gerekirse açabilirsiniz
# ============================================
# NEXT_PUBLIC_SUPABASE_URL_PROD=<YOUR_SUPABASE_PROJECT_URL>
# NEXT_PUBLIC_SUPABASE_ANON_KEY_PROD=<YOUR_SUPABASE_ANON_KEY>
# SUPABASE_SERVICE_ROLE_KEY_PROD=<YOUR_SUPABASE_SERVICE_ROLE_KEY>

# ============================================
# Jira OAuth (Test/Local) - ZORUNLU (Jira kullanıyorsanız)
# ============================================
JIRA_CLIENT_ID_TEST=<YOUR_JIRA_CLIENT_ID>
JIRA_CLIENT_SECRET_TEST=<YOUR_JIRA_CLIENT_SECRET>
NEXT_PUBLIC_APP_URL_TEST=http://localhost:3000

# ============================================
# Jira OAuth (Production) - OPSİYONEL
# Production değerleri yorum satırında tutuluyor, gerekirse açabilirsiniz
# ============================================
# JIRA_CLIENT_ID_PROD=<YOUR_JIRA_CLIENT_ID>
# JIRA_CLIENT_SECRET_PROD=<YOUR_JIRA_CLIENT_SECRET>
# NEXT_PUBLIC_APP_URL_PROD=https://your-production-domain.com

# ============================================
# Site URL - ZORUNLU
# ============================================
NEXT_PUBLIC_SITE_URL_TEST=http://localhost:3000

# ============================================
# Site URL (Production) - OPSİYONEL
# Production değerleri yorum satırında tutuluyor, gerekirse açabilirsiniz
# ============================================
# NEXT_PUBLIC_SITE_URL_PROD=https://your-production-domain.com

# ============================================
# Jira Base URL (Opsiyonel - Fallback)
# ============================================
JIRA_BASE_URL=<your-domain>.atlassian.net

# ============================================
# Bitbucket (Opsiyonel - Eğer kullanıyorsanız)
# ============================================
# BITBUCKET_CLIENT_ID=<YOUR_BITBUCKET_CLIENT_ID>
# BITBUCKET_CLIENT_SECRET=<YOUR_BITBUCKET_CLIENT_SECRET>

